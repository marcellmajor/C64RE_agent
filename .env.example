# --- LLM provider keys (only the ones you actually use are required) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
# Ollama runs locally; no key needed.

# --- LangSmith tracing (so the run shows up in smith.langchain.com) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=c64re-agent

# --- Optional tool integrations ---
TAVILY_API_KEY=
VICE_MCP_URL=http://localhost:8765
