{
  "providers": {
    "ollama": {
      "base_url": "http://localhost:11434/v1",
      "api_key": "ollama"
    },
    "grok": {
      "base_url": "https://api.x.ai/v1",
      "api_key": "${XAI_API_KEY}"
    },
    "gemini": {
      "base_url": "https://generativelanguage.googleapis.com/v1beta/openai/",
      "api_key": "${GEMINI_API_KEY}"
    },
    "openai": {
      "base_url": "https://api.openai.com/v1",
      "api_key": "${OPENAI_API_KEY}"
    },
    "anthropic": {
      "base_url": "https://api.anthropic.com/v1",
      "api_key": "${ANTHROPIC_API_KEY}"
    }
  },
  "agents": {
    "coordinator": {
      "provider": "grok",
      "model": "grok-4.5",
      "temperature": 0.1,
      "reasoning_effort": "low"
    },
    "planner": {
      "provider": "anthropic",
      "model": "claude-opus-4-8",
      "temperature": 0.2,
      "max_tokens": 8192
    },
    "executor": {
      "provider": "openai",
      "model": "gpt-5.5",
      "temperature": 0.0
    },
    "synthesizer": {
      "provider": "grok",
      "model": "grok-4.5",
      "temperature": 0.3,
      "reasoning_effort": "low"
    },
    "analyst": {
      "provider": "gemini",
      "model": "gemini-pro-latest",
      "temperature": 0.2,
      "max_tokens": 8192
    },
    "critic": {
      "provider": "gemini",
      "model": "gemini-pro-latest",
      "temperature": 0.1
    },
    "curator": {
      "provider": "grok",
      "model": "grok-4.5",
      "temperature": 0.2,
      "reasoning_effort": "none"
    },
    "researcher": {
      "provider": "grok",
      "model": "grok-4.5",
      "temperature": 0.3,
      "reasoning_effort": "medium"
    },
    "vision": {
      "provider": "gemini",
      "model": "gemini-pro-latest",
      "temperature": 0.1,
      "max_tokens": 2048
    }
  },
  "tools": {
    "tavily": {
      "include_domains": [
        "csdb.dk",
        "codebase64.org",
        "lemon64.com",
        "gamebase64.com",
        "archive.org",
        "forum64.de",
        "c64-wiki.com"
      ],
      "search_depth": "advanced",
      "max_results": 5
    }
  },
  "defaults": {
    "max_tokens": 4096,
    "timeout_s": 120,
    "retries": 3
  }
}
