{
  "providers": {
    "ollama": {
      "base_url": "http://localhost:11434/v1",
      "api_key": "ollama"
    },
    "grok": {
      "base_url": "https://api.x.ai/v1",
      "api_key": "${XAI_API_KEY}"
    },
    "gemini": {
      "base_url": "https://generativelanguage.googleapis.com/v1beta/openai/",
      "api_key": "${GEMINI_API_KEY}"
    },
    "openai": {
      "base_url": "https://api.openai.com/v1",
      "api_key": "${OPENAI_API_KEY}"
    },
    "anthropic": {
      "base_url": "https://api.anthropic.com/v1",
      "api_key": "${ANTHROPIC_API_KEY}"
    }
  },
  "agents": {
    "planner": {
      "provider": "anthropic",
      "model": "claude-opus-5",
      "max_tokens": 8192
    },
    "executor": {
      "provider": "openai",
      "model": "gpt-5.6"
    },
    "synthesizer": {
      "provider": "grok",
      "model": "grok-4.6",
      "reasoning_effort": "medium"
    },
    "analyst": {
      "provider": "gemini",
      "model": "gemini-pro-latest",
      "max_tokens": 8192,
      "reasoning_effort": "medium"
    },
    "critic": {
      "provider": "gemini",
      "model": "gemini-pro-latest",
      "max_tokens": 8192,
      "reasoning_effort": "medium"
    },
    "curator": {
      "provider": "grok",
      "model": "grok-4.6",
      "reasoning_effort": "medium"
    },
    "vision": {
      "provider": "gemini",
      "model": "gemini-pro-latest",
      "max_tokens": 2048,
      "reasoning_effort": "medium"
    }
  },
  "tools": {
    "tavily": {
      "include_domains": [
        "csdb.dk",
        "codebase64.org",
        "lemon64.com",
        "gamebase64.com",
        "archive.org",
        "forum64.de",
        "c64-wiki.com"
      ],
      "search_depth": "advanced",
      "max_results": 5
    }
  },
  "pricing": {
    "claude-opus-5": {
      "input_per_mtok": 5.0,
      "output_per_mtok": 25.0
    },
    "gpt-5.6": {
      "input_per_mtok": 10.0,
      "output_per_mtok": 45.0
    },
    "grok-4.6": {
      "input_per_mtok": 4.0,
      "output_per_mtok": 12.0
    },
    "gemini-pro-latest": {
      "input_per_mtok": 4.0,
      "output_per_mtok": 18.0
    }
  },
  "defaults": {
    "max_tokens": 4096,
    "timeout_s": 120,
    "retries": 3,
    "structured_output": false
  }
}
